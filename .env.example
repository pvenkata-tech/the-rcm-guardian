# =============================================================================
# RCM Guardian — environment template
# Copy to `.env` beside `docker-compose.yml`. Compose loads `.env` automatically.
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI (required)
# RAG embeddings + primary multimodal document extraction.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Vector width for pgvector; must match the embedding model (e.g. 1536 for text-embedding-3-small, 3072 for text-embedding-3-large).
OPENAI_EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# Anthropic (optional)
# Used only if OpenAI vision fails and this key is set.
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-20241022

# -----------------------------------------------------------------------------
# LangSmith (required)
# Traces go to https://smith.langchain.com — do not set LANGCHAIN_TRACING_V2=false.
# -----------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rcm-guardian
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# -----------------------------------------------------------------------------
# LIMS — prior authorization HTTP API
# Docker Compose defaults to http://lims-mock:8080 if you omit this.
# -----------------------------------------------------------------------------
# LIMS_BASE_URL=https://your-real-lims.example

# -----------------------------------------------------------------------------
# Database / artifact dir (optional — host-only; Compose uses /uploads = ./samples/generated)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://rcm:rcm@127.0.0.1:5432/rcm_guardian
# UPLOADS_DIR=./samples/generated
# PERSIST_UPLOADS=true

# -----------------------------------------------------------------------------
# AWS / Terraform (set in deployed environments)
# -----------------------------------------------------------------------------
# DOCUMENTS_S3_BUCKET=
