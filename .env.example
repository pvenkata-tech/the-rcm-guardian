# Docker Compose reads this file automatically for variable substitution (same directory as compose.yml).

# Required: embeddings (RAG) always use OpenAI. Vision extraction tries OpenAI first, then Anthropic if configured.
OPENAI_API_KEY=

# Optional: used only when OpenAI vision fails (same extraction schema).
# ANTHROPIC_API_KEY=
# ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-20241022

# Optional overrides:
# OPENAI_VISION_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ═══════════════════════════════════════════════════════════════════════════════
# Hybrid: API on host, DB + LIMS in Docker — uncomment and adjust:
# DATABASE_URL=postgresql+asyncpg://rcm:rcm@127.0.0.1:5432/rcm_guardian
# LIMS_BASE_URL=http://127.0.0.1:8081
# UPLOADS_DIR=./uploads
# PERSIST_UPLOADS=true

# AWS / Fargate (set by Terraform):
# DOCUMENTS_S3_BUCKET=
